NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# For Docker: mongodb://mongo:27017/collab | Local: mongodb://localhost:27017/collab
MONGO_URI=mongodb://localhost:27017/collab
# For Docker: redis://redis:6379 | Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=collab
CACHE_TTL_SECONDS=120

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

RATE_LIMIT_REVIEWS_PER_HOUR=10
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=120

# Get free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# For Docker: http://chromadb:8000 | Local: http://localhost:8000
CHROMA_URL=http://localhost:8000
RAG_DOCS_PATH=./rag-data/sample-docs

YJS_PERSIST_DEBOUNCE_MS=5000
YJS_PERSIST_MAX_MS=30000
YJS_ROOM_TTL_MS=300000
AUTO_SAVE_LIMIT=50
# Minimum gap between auto-save versions (ms). Default 5 minutes.
AUTO_SAVE_INTERVAL_MS=300000

LOG_LEVEL=info

VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001
