# =============================================================================
# Agent Runner — append these to your .env
# =============================================================================
# Kept in a separate file so .env.example stays untouched; the subsystem is
# removable without editing any existing file (see REMOVAL.md).
#
# Every value below is optional and defaults to what is shown here. With
# AGENT_RUNNER_ENABLED unset, none of it is read and the subsystem is inert.

# Master switch. When false: no routes register, no worker starts, no cron
# schedules, and dockerode/bullmq/node-cron are never even required.
AGENT_RUNNER_ENABLED=false

# --- Redis / queue isolation -------------------------------------------------
# Dedicated logical DB so BullMQ keys cannot collide with the app's keys, which
# all live on DB 0 under the "collab:" prefix.
AGENT_RUNNER_REDIS_DB=3
AGENT_RUNNER_QUEUE_PREFIX=agentrunner
AGENT_RUNNER_QUEUE_NAME=agent-runs
# Runs execute one at a time. Raising this stacks concurrent runs against the
# Gemini quota shared with the RAG reviewer.
AGENT_RUNNER_WORKER_CONCURRENCY=1

# --- Trigger layer -----------------------------------------------------------
# Shared secret for the webhook HMAC. REQUIRED to use POST /api/runs/trigger/:taskId.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_RUNNER_WEBHOOK_SECRET=
# How old a signed delivery may be before it is rejected (seconds).
AGENT_RUNNER_WEBHOOK_TOLERANCE_SEC=300
# How long an idempotency key is remembered (seconds). Default 24h.
AGENT_RUNNER_IDEMPOTENCY_TTL_SEC=86400
AGENT_RUNNER_CRON_ENABLED=true

# --- Sandbox -----------------------------------------------------------------
# Build with:
#   docker build -f server/src/agent-runner/sandbox/Dockerfile.agent-sandbox \
#                -t agent-sandbox:node20 .
AGENT_RUNNER_SANDBOX_IMAGE=agent-sandbox:node20
AGENT_RUNNER_TIMEOUT_MS=30000
# Hard cap on captured stdout+stderr per run, shared across both streams.
AGENT_RUNNER_MAX_OUTPUT_BYTES=1048576
AGENT_RUNNER_MEMORY_MB=512
AGENT_RUNNER_CPUS=0.5
AGENT_RUNNER_PIDS_LIMIT=128
AGENT_RUNNER_TMPFS_SIZE_MB=64
# Generated source is injected through the container Cmd, which the kernel caps
# at 128KB for a single argument (MAX_ARG_STRLEN). Base64 inflates by 4/3, so
# 64KB of source is the practical ceiling. Raising this will fail loudly.
AGENT_RUNNER_CODE_MAX_BYTES=65536

# --- Agent loop --------------------------------------------------------------
AGENT_RUNNER_MAX_ATTEMPTS=3

# --- Gemini budget -----------------------------------------------------------
# PINNED model — there is deliberately no fallback chain. On 404, or on a 429
# reporting "limit: 0" (no free-tier allocation), the run fails loudly rather
# than silently substituting a different, possibly pricier, model.
#
# NOTE: gemini-2.0-flash currently returns 429 limit:0 on the free tier. It is
# listed by ListModels but can never serve. Do not set it here.
AGENT_RUNNER_GEMINI_MODEL=gemini-2.5-flash
# Client-side token bucket. On limit, calls QUEUE and wait — never dropped.
AGENT_RUNNER_GEMINI_RPM=6
# Per-run ceiling. Exceeding it terminates the run as `budget_exceeded`.
AGENT_RUNNER_GEMINI_CALLS_PER_RUN=6
# Global daily ceiling in Redis, resets midnight Pacific. Exceeding it refuses
# new runs with a clear error rather than silently burning the reviewer's quota.
AGENT_RUNNER_GEMINI_DAILY_CAP=200
# Replays the last successful run from Mongo without calling the API, so a live
# demo can never fail on a rate limit.
DEMO_CACHE=false

# --- Artifacts ---------------------------------------------------------------
# Path as seen by THIS process.
AGENT_RUNNER_ARTIFACTS_PATH=./artifacts
# Path as seen by the DOCKER DAEMON. When the server runs in a container but
# drives the host daemon, sandbox containers are siblings of it, so a bind mount
# source must be a HOST path — not a path inside the server container. Leave
# empty when running the server directly on the host.
# docker-compose.yml sets this to ${PWD}/artifacts.
AGENT_RUNNER_ARTIFACTS_HOST_PATH=
